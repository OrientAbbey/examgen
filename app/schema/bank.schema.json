{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Banque d'exercices — export/import",
  "type": "object",
  "required": ["schemaVersion", "matieres", "parties", "classes", "specialites", "exercices"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "exportedAt": {"type": "string"},
    "matieres": {"type": "array", "items": {
      "type": "object", "required": ["id", "nom"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "nom": {"type": "string", "minLength": 1}}}},
    "parties": {"type": "array", "items": {
      "type": "object", "required": ["id", "matiereId", "nom"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "matiereId": {"type": "string"},
                     "nom": {"type": "string", "minLength": 1}, "ordre": {"type": "integer"}}}},
    "classes": {"type": "array", "items": {
      "type": "object", "required": ["id", "nom"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "nom": {"type": "string", "minLength": 1},
                     "classePrecedenteId": {"type": ["string", "null"]},
                     "aExamen": {"type": "boolean"}, "specialiteObligatoire": {"type": "boolean"}}}},
    "specialites": {"type": "array", "items": {
      "type": "object", "required": ["id", "nom"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "nom": {"type": "string", "minLength": 1}}}},
    "exercices": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "sujet", "corrige", "affectations", "classeIds", "specialiteIds", "session", "niveauIntrinseque"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sujet": {"type": "string", "minLength": 1},
        "corrige": {"type": "string", "minLength": 1},
        "affectations": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["matiereId", "partieId"], "additionalProperties": false,
          "properties": {"matiereId": {"type": "string"}, "partieId": {"type": "string"}}}},
        "classeIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "specialiteIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "session": {"enum": [1, 2, 3, 4, 5, 6, null]},
        "niveauIntrinseque": {"enum": ["Facile", "Moyen", "Difficile"]},
        "tagExamen": {"type": "boolean"}}}}
  }
}
