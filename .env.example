# Copier en .env puis renseigner. Ne jamais committer .env.
EXAMGEN_ADMIN_TOKEN=remplacer-par-un-long-secret-aleatoire   # ex. : openssl rand -hex 24
DOMAIN=localhost                                              # votre domaine (ex. monapp.duckdns.org) → HTTPS automatique

# Assistant IA (facultatif, voir docs/ASSISTANT_IA.md). Exemple Ollama installé sur la machine hôte :
#EXAMGEN_LLM_BASE_URL=http://host.docker.internal:11434/v1
#EXAMGEN_LLM_MODEL=nom-du-modele
#EXAMGEN_LLM_API_KEY=
#EXAMGEN_LLM_PROVIDER=openai
#EXAMGEN_AI_PUBLIC=1
